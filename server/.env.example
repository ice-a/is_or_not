# ===== 方式一：CloudBase 云托管（关联数据库自动注入）=====
# 在云托管「关联数据库」后，DATABASE_URL 会自动注入，无需手动填。
# AI 网关（OpenAI 兼容）
AI_BASE_URL=https://dev-d4g97a4h5772bec4a.api.tcloudbasegateway.com/v1/ai/cloudbase
AI_KEY=your_cloudbase_ai_gateway_key
AI_MODEL=hy3

# ===== 方式二：Vercel + Supabase（serverless）=====
# 1) Supabase 连接串（推荐用 Transaction pooler，端口 6543，自带 pgbouncer + sslmode）
#    Dashboard → Settings → Database → Connection string → URI（Transaction pooler）
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xxx.pooler.supabase.co:6543/postgres?pgbouncer=true&sslmode=require
# 2) 公网 / 共享集群需 SSL：
# DATABASE_SSL=1
# 3) serverless 下关闭常驻 worker（由 getVerdict 惰性处理）+ 限制 AI 超时避免超过函数 10s 上限
# VERCEL=1
# AI_TIMEOUT=9000
# 4) 若用 Supabase 直连（端口 5432）而非 pooler，连接数更紧张，建议仍用 pooler。

# ===== 业务配置（两种环境通用）=====
FREE_QUOTA=10
WORKER_INTERVAL=5000
PORT=3000

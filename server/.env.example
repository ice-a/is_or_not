# ===== PostgreSQL 连接 =====
# 云托管「关联数据库」后会自动注入连接信息；下面是最常用的两种写法，二选一。
# 推荐：直接给完整连接串（pg 库原生支持）
DATABASE_URL=postgres://user:password@host:5432/dbname
# 或拆字段（当 DATABASE_URL 未设置时生效）
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=postgres
# 若数据库要求 SSL（部分云厂商内网不要求，公网可能需要）：
# DATABASE_SSL=1

# ===== CloudBase AI 网关（OpenAI 兼容）=====
# 控制台「AI」或「云托管环境变量」里拿到 key 后填到这里。
# baseURL 格式：https://<你的云环境ID>.api.tcloudbasegateway.com/v1/ai/cloudbase
AI_BASE_URL=https://dev-d4g97a4h5772bec4a.api.tcloudbasegateway.com/v1/ai/cloudbase
AI_KEY=your_cloudbase_ai_gateway_key
AI_MODEL=hy3

# ===== 业务配置 =====
FREE_QUOTA=10
WORKER_INTERVAL=5000

# 服务端口（云托管会自动注入 PORT，本地用 3000 调试）
PORT=3000

/* miniprogram/app.wxss — 全局样式与适老化设计令牌 */
page {
  /* 字号基准：正文 ≥18px，系统默认 16 偏小 */
  --fs-base: 18px;
  --fs-title: 22px;
  --fs-verdict: 34px;
  --tap-min: 56px;          /* 最小点击热区 */
  --radius: 20rpx;
  --c-danger: #E23B2E;      /* 假 */
  --c-safe: #1E9E4A;        /* 真 */
  --c-warn: #C8920A;        /* 说不准 */
  --c-primary: #1A6FC4;
  --c-primary-deep: #12539A;
  --c-gold: #E8902B;        /* 打赏暖色 */
  --c-text: #26241F;
  --c-sub: #8A857C;
  --bg: #F4F6F8;
  --bg-soft: #FFFFFF;
  --card: #ffffff;
  --line: #EDEBE6;

  background: var(--bg);
  color: var(--c-text);
  font-size: var(--fs-base);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  line-height: 1.7;
}

/* 长辈模式：根节点加 .elder，字号整体放大，行高更松 */
page.elder,
.elder {
  --fs-base: 24px;
  --fs-title: 30px;
  --fs-verdict: 46px;
  line-height: 1.9;
}

view, text, button, textarea, input { box-sizing: border-box; }

.container { padding: 24rpx 28rpx; }

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(28, 40, 60, 0.05);
  border: 1rpx solid var(--line);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #2A86E0, var(--c-primary-deep));
  color: #fff;
  border-radius: 999rpx;
  min-height: var(--tap-min);
  font-size: var(--fs-title);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(26, 111, 196, 0.28);
}
.btn-primary[disabled] { background: #b9c6d6; box-shadow: none; }
.btn-primary::after { border: none; }

.btn-ghost {
  background: #fff;
  color: var(--c-primary);
  border: 2rpx solid var(--c-primary);
  border-radius: 999rpx;
  min-height: var(--tap-min);
  font-size: var(--fs-base);
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-ghost::after { border: none; }

.muted { color: var(--c-sub); font-size: 24rpx; }

/* 通用：柔和顶部渐变条，用于各页头图氛围 */
.hero-grad {
  background: linear-gradient(135deg, #E8F2FE, #F3F7FB);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

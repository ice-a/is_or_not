/* miniprogram/app.wxss — 全局样式与适老化设计令牌 */
page {
  /* 字号基准：正文 ≥18px，系统默认 16 偏小 */
  --fs-base: 18px;
  --fs-title: 22px;
  --fs-verdict: 34px;
  --tap-min: 56px;          /* 最小点击热区 */
  --radius: 16rpx;
  --c-danger: #D93025;      /* 假 */
  --c-safe: #1E8E3E;        /* 真 */
  --c-warn: #B8860B;        /* 说不准 */
  --c-primary: #185FA5;
  --c-text: #2C2C2A;
  --c-sub: #888780;
  --bg: #F7F6F3;
  --card: #ffffff;

  background: var(--bg);
  color: var(--c-text);
  font-size: var(--fs-base);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  line-height: 1.7;
}

/* 长辈模式：根节点加 .elder，字号整体放大，行高更松 */
page.elder,
.elder {
  --fs-base: 24px;
  --fs-title: 30px;
  --fs-verdict: 46px;
  line-height: 1.9;
}

view, text, button, textarea { box-sizing: border-box; }

.container { padding: 24rpx 28rpx; }

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.btn-primary {
  background: var(--c-primary);
  color: #fff;
  border-radius: 999rpx;
  min-height: var(--tap-min);
  font-size: var(--fs-title);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-primary[disabled] { background: #b9c6d6; }
.btn-primary::after { border: none; }

.btn-ghost {
  background: #fff;
  color: var(--c-primary);
  border: 2rpx solid var(--c-primary);
  border-radius: 999rpx;
  min-height: var(--tap-min);
  font-size: var(--fs-base);
  display: flex;
  align-items: center;
  justify-content: center;
}

.muted { color: var(--c-sub); font-size: 24rpx; }

.hero {
  background: linear-gradient(135deg, #E8F2FE, #F2F7FC);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.hero-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--c-primary-deep);
  line-height: 1.4;
}
.hero-sub {
  color: var(--c-sub);
  font-size: 26rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}

.input-card { padding: 24rpx; }
.input {
  width: 100%;
  min-height: 280rpx;
  font-size: var(--fs-base);
  line-height: 1.7;
  padding: 8rpx;
}
.ph { color: #b9b6ae; }

.counter {
  text-align: right;
  color: var(--c-sub);
  font-size: 22rpx;
  margin-top: 4rpx;
}
.counter.warn { color: var(--c-danger); }

.row { display: flex; align-items: center; margin-top: 12rpx; }
.spacer { flex: 1; }
.chip {
  background: #E6F1FB; color: var(--c-primary);
  border-radius: 999rpx; padding: 14rpx 30rpx; font-size: 28rpx; margin-right: 16rpx;
}
.chip.ghost { background: #f0f0ec; color: var(--c-sub); }
.type-tag { color: var(--c-sub); font-size: 24rpx; }

.examples { margin: 28rpx 0; }
.ex-title { margin-bottom: 16rpx; }
.ex-scroll {
  white-space: nowrap;
  width: 100%;
}
.ex {
  display: inline-flex;
  align-items: center;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #444;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.submit { margin-top: 8rpx; width: 100%; }
.tip { margin-top: 20rpx; line-height: 1.6; }
